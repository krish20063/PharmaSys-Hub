# =====================================================================
# PharmaSys Hub - Example Environment Template
# Copy this file to .env and fill with your actual environment values.
# =====================================================================

APP_ENV=production
APP_DEBUG=false
APP_SECRET=generate_your_own_64_character_crypto_random_key_here
APP_URL=http://localhost:8000

# Database Configuration
DB_TYPE=auto
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharmasys_hub
DB_USER=your_db_user
DB_PASS=your_db_password

# Meta WhatsApp Cloud API Credentials
WHATSAPP_API_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id
WHATSAPP_API_VERSION=v19.0

# Security & Rate Limiting Settings
SESSION_LIFETIME_SECONDS=7200
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_DECAY_MINUTES=15
API_RATE_LIMIT_MAX_PER_MINUTE=60

